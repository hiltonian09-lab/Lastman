# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Stripe (test mode keys from dashboard.stripe.com while in development)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# API-Football (v3.football.api-sports.io) — historical seasons only on free tier
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# football-data.org — free tier, current season. Primary data source.
FOOTBALL_DATA_API_TOKEN=

# Auth
AUTH_SECRET=

# Email (Resend) — optional until notifications are built
RESEND_API_KEY=
